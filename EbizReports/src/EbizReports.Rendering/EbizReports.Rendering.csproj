  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EbizReports.Core\EbizReports.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\..\LatoFont\Lato-Regular.ttf" Link="Fonts\Lato-Regular.ttf" />
    <EmbeddedResource Include="..\..\..\LatoFont\Lato-Bold.ttf" Link="Fonts\Lato-Bold.ttf" />
    <EmbeddedResource Include="..\..\..\LatoFont\Lato-Italic.ttf" Link="Fonts\Lato-Italic.ttf" />
    <EmbeddedResource Include="..\..\..\LatoFont\Lato-BoldItalic.ttf" Link="Fonts\Lato-BoldItalic.ttf" />
    <EmbeddedResource Include="..\..\..\LatoFont\Lato-Medium.ttf" Link="Fonts\Lato-Medium.ttf" />
    <EmbeddedResource Include="..\..\..\LatoFont\Lato-SemiBold.ttf" Link="Fonts\Lato-SemiBold.ttf" />
  </ItemGroup>


</Project>
