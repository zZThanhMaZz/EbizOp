    private void CopySelected()
    {
        if (_sel.Count == 0)
            return;
        _clipboard.Clear();
        foreach (var it in _sel)
            _clipboard.Add(it.Clone());
        _pasteCount = 0;
    }

    [JSInvokable]
    public async Task OnCut()
    {
        if (_sel.Count == 0)
            return;
        CopySelected();
        await RemoveSelectedAsync();
    }

    [JSInvokable]
    public async Task OnPaste() => await PasteAsync();

    private async Task PasteAsync()
    {
        if (_clipboard.Count == 0)
            return;
        var band = _band ?? Definition.Bands.FirstOrDefault();
        if (band is null)
            return;

        PushHistory();
        _pasteCount++;
        var off = 3.0 * _pasteCount;
        var clones = new List<ReportItem>();
        foreach (var src in _clipboard)
        {
            var copy = src.Clone();
            copy.X += off;
            copy.Y += off;
            band.Items.Add(copy);
            clones.Add(copy);
        }

        _band = band;
        _bandIdx = Definition.Bands.IndexOf(band);
        _sel.Clear();
        _sel.AddRange(clones);
        _item = clones[^1];
        await Notify();
    }

