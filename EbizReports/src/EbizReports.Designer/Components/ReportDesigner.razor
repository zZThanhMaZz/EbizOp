    }

    private async Task MoveColumnAsync(int idx, int dir)
    {
        var j = idx + dir;
        if (_item is null || idx < 0 || idx >= Table.Columns.Count || j < 0 || j >= Table.Columns.Count)
            return;
        (Table.Columns[idx], Table.Columns[j]) = (Table.Columns[j], Table.Columns[idx]);
        await EditedAsync(EditKey.Table);
    }

    [JSInvokable]
    public async Task OnDuplicate() => await DuplicateSelectedAsync();

    private async Task DuplicateSelectedAsync()
    {
        if (_sel.Count == 0)
            return;
        PushHistory();
        var clones = new List<ReportItem>();
        foreach (var band in Definition.Bands)
        {
            foreach (var it in band.Items.ToList())
            {
                if (!_sel.Contains(it))
                    continue;
                var copy = it.Clone();
                copy.X += 3;
                copy.Y += 3;
                band.Items.Add(copy);
                clones.Add(copy);
            }
        }
        if (clones.Count == 0)
            return;
        _sel.Clear();
        _sel.AddRange(clones);
        _item = clones[^1];
        await Notify();
    }

    private async Task RemoveSelectedAsync()
    {
        var removable = _sel.Where(it => !it.Locked).ToList();
        if (removable.Count == 0)
            return;
        PushHistory();
        foreach (var band in Definition.Bands)
            band.Items.RemoveAll(it => removable.Contains(it));
        _sel.Clear();
        _item = null;
        await Notify();
    }

