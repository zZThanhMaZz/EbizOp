    // ------------------------------------------------------------ align / distribute

    private enum AlignMode { Left, CenterH, Right, Top, Middle, Bottom }

    private async Task AlignAsync(AlignMode mode)
    {
        if (_sel.Count < 2)
            return;
        PushHistory();
        var items = _sel.ToList();
        var minX = items.Min(i => i.X);
        var maxX = items.Max(i => i.X + i.W);
        var minY = items.Min(i => i.Y);
        var maxY = items.Max(i => i.Y + i.H);
        var cx = (minX + maxX) / 2;
        var cy = (minY + maxY) / 2;

        foreach (var it in items)
        {
            switch (mode)
            {
                case AlignMode.Left: it.X = minX; break;
                case AlignMode.Right: it.X = maxX - it.W; break;
                case AlignMode.CenterH: it.X = cx - it.W / 2; break;
                case AlignMode.Top: it.Y = minY; break;
                case AlignMode.Bottom: it.Y = maxY - it.H; break;
                case AlignMode.Middle: it.Y = cy - it.H / 2; break;
            }
        }
        await Notify();
    }

    private async Task DistributeAsync(bool horizontal)
    {
        if (_sel.Count < 3)
            return;
        PushHistory();
        var items = horizontal
            ? _sel.OrderBy(i => i.X).ToList()
            : _sel.OrderBy(i => i.Y).ToList();

        if (horizontal)
        {
            var left = items[0].X;
            var right = items[^1].X + items[^1].W;
            var total = items.Sum(i => i.W);
            var gap = (right - left - total) / (items.Count - 1);
            var cursor = left;
            foreach (var it in items)
            {
                it.X = cursor;
                cursor += it.W + gap;
            }
        }
        else
        {
            var top = items[0].Y;
            var bottom = items[^1].Y + items[^1].H;
            var total = items.Sum(i => i.H);
            var gap = (bottom - top - total) / (items.Count - 1);
            var cursor = top;
            foreach (var it in items)
            {
                it.Y = cursor;
                cursor += it.H + gap;
            }
        }
        await Notify();
    }

