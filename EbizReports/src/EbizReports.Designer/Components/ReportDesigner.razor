    /// <summary>Đổi chỗ một phần tử trong danh sách (lưu mốc hoàn tác).</summary>
    private void MoveEntry<T>(List<T> list, int index, int delta)
    {
        var target = index + delta;
        if (index < 0 || index >= list.Count || target < 0 || target >= list.Count)
            return;
        PushHistory();
        (list[index], list[target]) = (list[target], list[index]);
    }

