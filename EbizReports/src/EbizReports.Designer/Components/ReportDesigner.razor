    private async Task UngroupSelectedAsync()
    {
        if (!_sel.Any(it => !string.IsNullOrEmpty(it.Group)))
            return;
        PushHistory();
        foreach (var it in _sel)
            it.Group = null;
        await Notify();
    }

    private async Task LockSelectedAsync(bool locked)
    {
        var targets = _sel.Where(it => it.Locked != locked).ToList();
        if (targets.Count == 0)
            return;
        PushHistory();
        foreach (var it in targets)
            it.Locked = locked;
        await Notify();
    }

