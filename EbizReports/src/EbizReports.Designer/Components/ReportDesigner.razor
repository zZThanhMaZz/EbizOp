    /// <summary>Chạy thử câu SQL qua host; cột trả về được đưa vào panel “Trường dữ liệu”.</summary>
    private async Task RunProbeAsync()
    {
        if (_ds is null || TestDataSource is null)
            return;

        _probing = true;
        _probeResult = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            _probeResult = await TestDataSource(_ds, Definition);
            if (_probeResult?.Ok == true)
            {
                _probeFields.Clear();
                var first = _probeResult.Rows.FirstOrDefault();
                foreach (var col in _probeResult.Columns)
                {
                    _probeFields.Add(new ReportFieldInfo
                    {
                        Name = col,
                        Category = "detail",
                        Sample = first is not null && first.TryGetValue(col, out var v)
                            ? ValueFormatter.Format(v, null)
                            : null,
                    });
                }
            }
        }
        finally
        {
            _probing = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Danh sách tham số bắt buộc còn thiếu (null nếu đã đủ).</summary>
    private string? MissingRequiredParams()
    {
        var missing = new List<string>();
        foreach (var p in Definition.Parameters)
        {
            if (!p.Required || string.IsNullOrWhiteSpace(p.Name))
                continue;
            if (CollectParamValue(p) is null)
                missing.Add(ParamLabel(p));
        }
        return missing.Count == 0 ? null : string.Join(", ", missing);
    }

    private object? CollectParamValue(ReportParameter p)
    {
        if (string.IsNullOrWhiteSpace(p.Name))
            return null;
        switch (p.Type)
        {
            case ReportParameterType.Bool:
                return _paramBool.TryGetValue(p.Name, out var b) ? b : null;
            case ReportParameterType.Date:
                return _paramDates.TryGetValue(p.Name, out var d) ? (object?)d : null;
            default:
                return _paramText.TryGetValue(p.Name, out var s) && !string.IsNullOrWhiteSpace(s)
                    ? ReportParameterDefaults.FromString(p, s)
                    : null;
        }
    }

    private Dictionary<string, object?> CollectParamValues()
    {
        var values = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        foreach (var p in Definition.Parameters)
        {
            if (string.IsNullOrWhiteSpace(p.Name))
                continue;
            var v = CollectParamValue(p);
            if (v is not null)
                values[p.Name] = v;
        }
        return values;
    }

    private async Task MoveZAsync(int mode)
    {
        var band = _band;
        var item = _item;
        if (band is null || item is null)
            return;
        var list = band.Items;
        var i = list.IndexOf(item);
        if (i < 0)
            return;

        var j = mode switch
        {
            0 => 0,                              // xuống cuối
            1 => Math.Min(list.Count - 1, i + 1),// lên
            2 => Math.Max(0, i - 1),             // xuống
            3 => list.Count - 1,                 // lên đầu
            _ => i,
        };
        if (j == i)
            return;

        PushHistory();
        list.RemoveAt(i);
        list.Insert(j, item);
        await Notify();
    }

