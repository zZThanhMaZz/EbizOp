    /// <summary>
    /// Dựng danh sách hàng thuộc tính cho lưới bên phải. Luôn có nhóm “Báo cáo”; khi chọn item
    /// thì thêm các nhóm Bố cục / Dữ liệu / Giao diện / Hành vi.
    /// </summary>
    private IReadOnlyList<PropertyRow> PropertyRows()
    {
        var rows = new List<PropertyRow>();
        var d = Definition;

        PropertyRow Add(string id, string label, string cat, PropertyKind kind, object? val,
            Action<object?>? apply = null, EditKey key = EditKey.Param, string? ph = null,
            IReadOnlyList<string>? options = null, string? hint = null, string? swatch = null)
        {
            var row = new PropertyRow
            {
                Key = id,
                Label = label,
                Category = cat,
                Kind = kind,
                Value = val,
                Apply = apply,
                EditKey = key.ToString(),
                Placeholder = ph,
                Options = options,
                Hint = hint,
                Swatch = swatch,
            };
            rows.Add(row);
            return row;
        }

        static double D(object? v)
        {
            try { return v is null ? 0 : Convert.ToDouble(v, CultureInfo.InvariantCulture); }
            catch { return 0; }
        }
        static string S(object? v) => v?.ToString() ?? "";
        static bool B(object? v) => v is bool b && b;

        // ---- Báo cáo ----
        Add("paper.size", "Khổ giấy", "Báo cáo", PropertyKind.Enum, d.Paper.Size.ToString(),
            v => { if (Enum.TryParse<PaperSizeKind>(S(v), out var s)) d.Paper.Size = s; },
            options: Enum.GetNames<PaperSizeKind>());
        Add("paper.orient", "Hướng giấy", "Báo cáo", PropertyKind.Enum, d.Paper.Orientation.ToString(),
            v => { if (Enum.TryParse<PaperOrientation>(S(v), out var s)) d.Paper.Orientation = s; },
            options: Enum.GetNames<PaperOrientation>());

        // ---- Item ----
        if (_item is { } it)
        {
            Add("item.x", "X (mm)", "Bố cục", PropertyKind.Number, it.X, v => it.X = D(v), EditKey.X);
            Add("item.y", "Y (mm)", "Bố cục", PropertyKind.Number, it.Y, v => it.Y = D(v), EditKey.Y);
            Add("item.w", "Rộng (mm)", "Bố cục", PropertyKind.Number, it.W, v => it.W = D(v), EditKey.W);
            Add("item.h", "Cao (mm)", "Bố cục", PropertyKind.Number, it.H, v => it.H = D(v), EditKey.H);

            if (it.Kind is ItemKind.Text or ItemKind.PageNumber)
                Add("item.text", "Text", "Dữ liệu", PropertyKind.Text, it.Text,
                    v => it.Text = S(v), EditKey.Text, ph: "Nội dung hiển thị");
            if (it.Kind == ItemKind.Field)
                Add("item.bind", "Binding", "Dữ liệu", PropertyKind.Text, it.Binding,
                    v => it.Binding = S(v), EditKey.Bind, ph: "TenHoac.Nhom.Field");

            var complexKind = it.Kind is ItemKind.Chart or ItemKind.Table or ItemKind.Image or ItemKind.Subreport
                              || Symbology.IsSymbology(it.Kind);
            if (!complexKind)
                Add("item.format", "Format", "Dữ liệu", PropertyKind.Text, it.Format,
                    v => it.Format = S(v), EditKey.Format, ph: "N0 / dd/MM/yyyy");

            Add("item.size", "Cỡ chữ (pt)", "Giao diện", PropertyKind.Number, it.Style.Size,
                v => it.Style.Size = D(v), EditKey.Size);
            Add("item.align", "Căn lề", "Giao diện", PropertyKind.Enum, it.Style.Align,
                v => it.Style.Align = S(v), EditKey.Align, options: new[] { "left", "center", "right" });
            Add("item.bold", "Đậm", "Giao diện", PropertyKind.Bool, it.Style.Bold,
                v => it.Style.Bold = B(v), EditKey.Bold);
            Add("item.italic", "Nghiêng", "Giao diện", PropertyKind.Bool, it.Style.Italic,
                v => it.Style.Italic = B(v), EditKey.Italic);
            Add("item.border", "Khung", "Giao diện", PropertyKind.Bool, it.Style.Border,
                v => it.Style.Border = B(v), EditKey.Border);
            Add("item.color", "Màu chữ", "Giao diện", PropertyKind.Color, it.Style.Color,
                v => it.Style.Color = S(v), EditKey.Color, ph: "#RRGGBB", swatch: it.Style.Color);
            Add("item.bg", "Nền", "Giao diện", PropertyKind.Color, it.Style.Background,
                v => it.Style.Background = S(v), EditKey.Color, ph: "#RRGGBB", swatch: it.Style.Background);

            Add("item.locked", "Khoá vị trí", "Hành vi", PropertyKind.Bool, it.Locked,
                v => it.Locked = B(v), EditKey.Lock);
        }

        // ---- Band (khi chọn band, không chọn item) ----
        if (_item is null && _band is { } bd)
        {
            Add("band.kind", "Loại band", "Band", PropertyKind.ReadOnly, bd.Kind.ToString());
            Add("band.height", "Chiều cao (mm)", "Band", PropertyKind.Number, bd.Height,
                v => bd.Height = Math.Max(4, D(v)), EditKey.H);
            Add("band.pagebreak", "Ngắt trang trước", "Band", PropertyKind.Bool, bd.PageBreakBefore,
                v => bd.PageBreakBefore = B(v), EditKey.Param);
            Add("band.count", "Số điều khiển", "Band", PropertyKind.ReadOnly, bd.Items.Count);
        }

        return rows;
    }

