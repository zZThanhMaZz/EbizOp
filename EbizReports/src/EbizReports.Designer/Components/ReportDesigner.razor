        _ctxY = y;
        _ctxOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnCloseContextMenu()
    {
        if (!_ctxOpen)
            return;
        _ctxOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    private void CloseCtx() => _ctxOpen = false;

    private bool CtxHasSel => _sel.Count > 0;
    private bool CtxHasClip => _clipboard.Count > 0 && _band != null;
    private bool CtxHasGroup => _sel.Any(i => !string.IsNullOrEmpty(i.Group));
    private bool CtxAllLocked => _sel.Count > 0 && _sel.All(i => i.Locked);

    private string CtxTitle()
    {
        if (_item != null)
            return ItemLabel(_item);
        if (_band != null)
            return "Band " + _band.Kind;
        return "Canvas";
    }

    private async Task CtxCopyAsync() { CloseCtx(); CopySelected(); await InvokeAsync(StateHasChanged); }
    private async Task CtxCutAsync() { CloseCtx(); await OnCut(); }
    private async Task CtxPasteAsync() { CloseCtx(); await PasteAsync(); }
    private async Task CtxDuplicateAsync() { CloseCtx(); await DuplicateSelectedAsync(); }
    private async Task CtxDeleteAsync() { CloseCtx(); await RemoveSelectedAsync(); }
    private async Task CtxAlignAsync(AlignMode mode) { CloseCtx(); await AlignAsync(mode); }
    private async Task CtxDistributeAsync(bool horizontal) { CloseCtx(); await DistributeAsync(horizontal); }
    private async Task CtxGroupAsync() { CloseCtx(); await GroupSelectedAsync(); }
    private async Task CtxUngroupAsync() { CloseCtx(); await UngroupSelectedAsync(); }
    private async Task CtxLockAsync() { var lockIt = !CtxAllLocked; CloseCtx(); await LockSelectedAsync(lockIt); }

    // ---------------- ribbon: định dạng nhanh ----------------

    private IEnumerable<ReportItem> StyleTargets =>
        _sel.Count > 0 ? _sel : (_item != null ? new[] { _item } : Enumerable.Empty<ReportItem>());

    private bool HasStyleTarget => _sel.Count > 0 || _item != null;
    private bool RibbonBold => HasStyleTarget && StyleTargets.All(i => i.Style.Bold);
    private bool RibbonItalic => HasStyleTarget && StyleTargets.All(i => i.Style.Italic);
    private bool RibbonBorder => HasStyleTarget && StyleTargets.All(i => i.Style.Border);
    private string RibbonAlign => StyleTargets.Select(i => i.Style.Align).FirstOrDefault() ?? "left";
    private double RibbonSize => StyleTargets.Select(i => i.Style.Size).FirstOrDefault();
    private string? RibbonColor => StyleTargets.Select(i => i.Style.Color).FirstOrDefault();

    private async Task SetStyleAsync(Action<ReportItem> apply, string key)
    {
        if (!HasStyleTarget)
            return;
        PushEdit(key);
        foreach (var it in StyleTargets.ToList())
            apply(it);
        await Notify();
    }

    private async Task RibbonBoldAsync() { var v = !RibbonBold; await SetStyleAsync(i => i.Style.Bold = v, "style.bold"); }
    private async Task RibbonItalicAsync() { var v = !RibbonItalic; await SetStyleAsync(i => i.Style.Italic = v, "style.italic"); }
    private async Task RibbonBorderAsync() { var v = !RibbonBorder; await SetStyleAsync(i => i.Style.Border = v, "style.border"); }
    private async Task RibbonAlignAsync(string align) => await SetStyleAsync(i => i.Style.Align = align, "style.align");
    private async Task RibbonSizeAsync(double size)
    {
        if (size <= 0)
            return;
        await SetStyleAsync(i => i.Style.Size = size, "style.size");
    }

    private async Task RibbonColorAsync(string? hex) =>
        await SetStyleAsync(i => i.Style.Color = string.IsNullOrWhiteSpace(hex) ? null : hex, "style.color");

    // ------------------------------------------------------------ toolbar

    private async Task SaveAsync()
    {
        if (_module is null)
            return;
        _coalesceKey = null;
        await _module.InvokeVoidAsync("downloadText", Definition.Code + ".json", Definition.ToJson());
    }

    private async Task LoadAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null)
            return;
        using var stream = file.OpenReadStream(2 * 1024 * 1024);
        using var reader = new StreamReader(stream);
        var json = await reader.ReadToEndAsync();
        try
        {
            var loaded = ReportDefinition.FromJson(json);
            _undo.Clear();
            _redo.Clear();
            _sel.Clear();
            _item = null;
            _paramText.Clear();
            _paramDates.Clear();
            _paramBool.Clear();
            _param = null;
            _paramIdx = -1;
            Definition = loaded;
            _bandIdx = loaded.Bands.Count > 0 ? 0 : -1;
            _band = loaded.Bands.FirstOrDefault();
            SyncParamValues();
            await Notify();
        }
        catch (Exception ex)
        {
            if (_module != null)
                await _module.InvokeVoidAsync("alertText", "JSON không hợp lệ: " + ex.Message);
        }
    }

    private async Task PreviewAsync()
    {
        if (RenderPreview is null || _module is null)
            return;
        var missing = MissingRequiredParams();
        if (missing is not null)
        {
            await _module.InvokeVoidAsync("alertText", "Thiếu tham số bắt buộc: " + missing);
            return;
        }
        var bytes = await RenderPreview(Definition, CollectParamValues());
        await _module.InvokeVoidAsync("showPdf", Convert.ToBase64String(bytes), "rd-pdf");
    }

    // ------------------------------------------------------------ xem trước WYSIWYG (nhiều trang)

    private async Task PreviewPagesAsync()
    {
        if (RenderPreviewPages is null || _module is null)
            return;
        var missing = MissingRequiredParams();
        if (missing is not null)
        {
            await _module.InvokeVoidAsync("alertText", "Thiếu tham số bắt buộc: " + missing);
            return;
        }

        IReadOnlyList<byte[]> pages;
        try
        {
            pages = await RenderPreviewPages(Definition, CollectParamValues());
        }
        catch (Exception ex)
        {
            await _module.InvokeVoidAsync("alertText", "Không render được xem trước: " + ex.Message);
            return;
        }

        _previewPages.Clear();
        foreach (var p in pages)
            _previewPages.Add("data:image/png;base64," + Convert.ToBase64String(p));
        _pvPage = 0;
        _pvZoom = 1;
        StateHasChanged();
        try { await _pvRef.FocusAsync(); } catch { }
    }

    private string PreviewImg() =>
        _previewPages.Count == 0 ? "" : _previewPages[Math.Clamp(_pvPage, 0, _previewPages.Count - 1)];

    private void PreviewGo(int page) => _pvPage = Math.Clamp(page, 0, _previewPages.Count - 1);

    private void PreviewSetZoom(double zoom) => _pvZoom = Math.Clamp(zoom, 0.25, 4);

    private void PreviewZoom(double factor) => PreviewSetZoom(Math.Round(_pvZoom * factor, 3));

    /// <summary>Đặt mức zoom sao cho bề rộng trang vừa khung xem (trừ lề).</summary>
    private async Task PreviewFitAsync()
    {
        if (_module is null)
            return;
        var width = await _module.InvokeAsync<double>("elementWidth", ".rd-pvw-body");
        var pagePx = PaperW * MmToPx;
        if (width > 0 && pagePx > 0)
            PreviewSetZoom((width - 32) / pagePx);
    }

    private void ClosePreview()
    {
        _previewPages.Clear();
        _pvPage = 0;
    }

    private async Task OnPreviewKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape": ClosePreview(); break;
            case "ArrowLeft": PreviewGo(_pvPage - 1); break;
            case "ArrowRight": PreviewGo(_pvPage + 1); break;
            case "+": case "=": PreviewZoom(1.25); break;
            case "-": PreviewZoom(1 / 1.25); break;
        }
        await StateHasChangedAsync();
    }

    private Task StateHasChangedAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }
}
