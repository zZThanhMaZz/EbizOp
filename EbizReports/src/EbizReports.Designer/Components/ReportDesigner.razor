    /// <summary>Danh sách trường khả dụng, đã lọc theo ô tìm kiếm (gồm cả cột lấy từ "Chạy thử").</summary>
    private IReadOnlyList<ReportFieldInfo> FieldList()
    {
        var all = new List<ReportFieldInfo>();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var f in _probeFields)
            if (seen.Add(f.Name))
                all.Add(f);
        if (AvailableFields is not null)
            foreach (var f in AvailableFields)
                if (seen.Add(f.Name))
                    all.Add(f);

        var q = _fieldFilter?.Trim();
        if (!string.IsNullOrEmpty(q))
            all = all.Where(f => f.Name.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
        return all;
    }

    private static string FieldCatLabel(string category) => category switch
    {
        "field" => "đơn",
        "param" => "TS",
        _ => "dòng",
    };

    private void OnFieldDragStart(ReportFieldInfo field) => _dragField = field.Name;

    private async Task OnFieldDropAsync(int bandIndex)
    {
        var field = _dragField;
        _dragField = null;
        if (string.IsNullOrEmpty(field))
            return;
        await AddFieldItemAsync(field, bandIndex);
    }

    /// <summary>
    /// Thêm item Field bind vào trường được chọn. Nếu chưa chọn band thì tự dùng band Detail
    /// (nếu có). Item đặt ở vị trí trống kế tiếp theo chiều dọc.
    /// </summary>
    private async Task AddFieldItemAsync(string field, int bandIndex)
    {
        if (bandIndex < 0 || bandIndex >= Definition.Bands.Count)
        {
            bandIndex = Definition.Bands.FindIndex(b => b.Kind == BandKind.Detail);
            if (bandIndex < 0)
                bandIndex = _bandIdx;
        }
        if (bandIndex < 0 || bandIndex >= Definition.Bands.Count)
            return;

        PushHistory();

        var band = Definition.Bands[bandIndex];
        _bandIdx = bandIndex;
        _band = band;

        var item = new ReportItem { Kind = ItemKind.Field, Binding = field };
        item.Y = NextFreeY(band);
        band.Items.Add(item);

        _sel.Clear();
        _sel.Add(item);
        _item = item;
        await Notify();
    }

    /// <summary>Y (mm) trống kế tiếp trong band: dưới item thấp nhất, chừa 1 dòng nếu band còn chỗ.</summary>
    private static double NextFreeY(ReportBand band)
    {
        var bottom = band.Items.Count == 0 ? 0 : band.Items.Max(i => i.Y + i.H);
        return Math.Round(bottom, 2);
    }

    /// <summary>
    /// Thêm bảng con của nhóm vào band GroupHeader (tạo band nếu chưa có). Bảng dùng toàn bộ
    /// bề rộng vùng in, phạm vi "group" → mỗi nhóm hiển thị các dòng của chính nó.
    /// </summary>
    private async Task AddGroupTableAsync()
    {
        PushHistory();

        var groupHeader = Definition.Bands.FirstOrDefault(b => b.Kind == BandKind.GroupHeader);
        if (groupHeader is null)
        {
            groupHeader = new ReportBand { Kind = BandKind.GroupHeader, Height = 54 };
            Definition.Bands.Add(groupHeader);
        }

        var avail = Definition.Paper.Resolve().Width
                    - Definition.Paper.Margins.Left - Definition.Paper.Margins.Right;

        // Đặt bảng dưới các item sẵn có và nới chiều cao band cho vừa.
        var top = groupHeader.Items.Count == 0 ? 0 : groupHeader.Items.Max(i => i.Y + i.H);
        const double tableH = 48;

        var table = new ReportItem
        {
            Kind = ItemKind.Table,
            X = 0,
            Y = Math.Round(top, 1),
            W = Math.Round(Math.Max(40, avail), 1),
            H = tableH,
            Table = new TableSpec
            {
                Scope = "group",
                ShowHeader = true,
                Borders = true,
                Footer = true,
                Columns =
                {
                    new TableColumn { Header = "Tên", Binding = "Name", Width = 60 },
                    new TableColumn { Header = "SL", Binding = "Qty", Align = "center", Width = 20, Aggregate = "sum", Format = "N0" },
                    new TableColumn { Header = "Thành tiền", Binding = "LineTotal", Align = "right", Width = 40, Aggregate = "sum", Format = "N0" },
                },
            },
        };

        if (groupHeader.Height < top + tableH + 2)
            groupHeader.Height = Math.Round(top + tableH + 2, 1);

        groupHeader.Items.Add(table);
        _bandIdx = Definition.Bands.IndexOf(groupHeader);
        _band = groupHeader;
        _sel.Clear();
        _sel.Add(table);
        _item = table;
        await Notify();
    }

