    private void AddItem(ItemKind kind)
    {
        if (_band is null)
            return;
        PushHistory();

        var item = new ReportItem { Kind = kind };
        if (kind == ItemKind.Text || kind == ItemKind.PageNumber)
            item.Text = kind == ItemKind.PageNumber ? "Trang {Page}/{Pages}" : "Nội dung";
        if (kind == ItemKind.Field)
            item.Binding = "Name";
        if (kind == ItemKind.Expression)
            item.Expression = "Sum(LineTotal)";
        if (kind == ItemKind.Barcode)
        {
            item.W = 60;
            item.H = 16;
            item.Text = "1234567890";
            item.Symbology = new SymbologySpec { Format = "Code128", ShowText = true };
        }
        if (kind == ItemKind.QrCode)
        {
            item.W = 25;
            item.H = 25;
            item.Text = "EbizOp";
            item.Symbology = new SymbologySpec { Ecc = "M" };
        }
        if (kind == ItemKind.Chart)
        {
            item.W = 90;
            item.H = 55;
            item.Chart = new ChartSpec { Type = "bar", Category = "Format(Ngay, 'dd/MM')", Value = "TongTien", Aggregate = "sum", Legend = "right" };
        }
        if (kind == ItemKind.Table)
        {
            item.W = 120;
            item.H = 40;
            item.Table = new TableSpec
            {
                ShowHeader = true,
                Borders = true,
                Footer = true,
                Columns =
                {
                    new TableColumn { Header = "Tên", Binding = "Name", Width = 60 },
                    new TableColumn { Header = "SL", Binding = "Qty", Align = "center", Width = 20, Aggregate = "sum", Format = "N0" },
                    new TableColumn { Header = "Thành tiền", Binding = "LineTotal", Align = "right", Width = 40, Aggregate = "sum", Format = "N0" },
                },
            };
        }

        if (kind == ItemKind.Subreport)
        {
            item.W = 180;
            item.H = 60;
            item.Subreport = new SubreportSpec
            {
                ReportCode = AvailableReports?.FirstOrDefault()?.Code ?? "",
                InheritParameters = true,
            };
        }

        if (kind == ItemKind.Image)
        {
            item.W = 40;
            item.H = 24;
            item.Src = "";
        }

        _band.Items.Add(item);
        _sel.Clear();
        _sel.Add(item);
        _item = item;
        _ = Notify();
    }

